source "https://rubygems.org"

# Match the GitHub Pages build environment and its supported Jekyll plugins.
gem "github-pages", group: :jekyll_plugins

# Ruby 4.0 no longer ships csv as a default gem, but Jekyll 3.9 requires it.
gem "csv"

# Liquid 4.0.4 fixes compatibility with Ruby 3.2+ (including Ruby 3.4).
gem "liquid", ">= 4.0.4"

# Ruby 4.0 no longer ships bigdecimal as a default gem, but Liquid 4 requires it.
gem "bigdecimal"
